ASTRAL_API_BASE_URL=https://api.astral4gamer.com/api/reseller/v1
ASTRAL_API_KEY=YOUR_ASTRAL_RESELLER_KEY
# sandbox or live
ASTRAL_MODE=sandbox
ASTRAL_USD_TO_XOF_RATE=600
ASTRAL_MARKUP_PERCENT=15
# Le catalogue autorisé est resynchronisé à la première visite puis à cet intervalle.
ASTRAL_CATALOG_SYNC_SECONDS=60

# Compte administrateur. Le mot de passe doit être stocké sous forme de hash scrypt,
# jamais en clair. Format : scrypt$SALT_HEXADECIMAL$HASH_HEXADECIMAL
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$CHANGE_ME$CHANGE_ME
# Durée d'une session avant reconnexion obligatoire
ADMIN_SESSION_MINUTES=480
CUSTOMER_SESSION_MINUTES=43200

# PostgreSQL isolé pour SILVERSE SHOP
DATABASE_URL=postgresql://silverse_shop:CHANGE_ME@127.0.0.1:5432/silverse_shop

# Prestataire de paiement à choisir au déploiement (ex: stripe, wave, paydunya)
PAYMENT_PROVIDER=unconfigured
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# FedaPay : la clé secrète reste uniquement sur le backend
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=sk_sandbox_CHANGE_ME
FEDAPAY_WEBHOOK_SECRET=wh_CHANGE_ME
# Laisser vide pour utiliser automatiquement l'URL officielle de l'environnement
FEDAPAY_API_BASE_URL=
# URL HTTPS publique utilisée pour le retour de paiement en production
APP_BASE_URL=http://127.0.0.1:8010
# Domaine public sans slash final, utilisé pour canonical, sitemap et robots.txt
PUBLIC_SITE_URL=https://shop.example.com

# Money Fusion / Fusion Pay
# URL privée générée dans Tableau de bord > API de paiement
MONEYFUSION_PAYMENT_URL=https://pay.moneyfusion.net/VOTRE_APPLICATION/VOTRE_IDENTIFIANT/pay/
# Clé créée dans Paramètres, utilisée uniquement pour les retraits
MONEYFUSION_PRIVATE_KEY=CHANGE_ME
# Secret aléatoire interne ajouté aux URL de webhook (minimum 32 octets)
MONEYFUSION_WEBHOOK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
MONEYFUSION_API_BASE_URL=https://pay.moneyfusion.net

# Serveur
HOST=127.0.0.1
PORT=8010
NODE_ENV=production
