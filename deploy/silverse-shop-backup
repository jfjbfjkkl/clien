#!/bin/sh
set -eu

backup_dir=/var/backups/silverse-shop
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
umask 077
install -d -o postgres -g postgres -m 0700 "$backup_dir"
sudo -u postgres pg_dump --format=custom --file="$backup_dir/silverse_shop-$timestamp.dump" silverse_shop
find "$backup_dir" -type f -name 'silverse_shop-*.dump' -mtime +14 -delete
